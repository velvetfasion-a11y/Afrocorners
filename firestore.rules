rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == "google.com"
        && request.auth.token.email is string;
    }

    function adminData() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && adminData().email.lower() == request.auth.token.email.lower()
        && adminData().role in ["owner", "developer"];
    }

    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /content/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /orders/{id} {
      allow create: if request.resource.data.status == "ny"
        && request.resource.data.stockApplied == false
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 40;
      allow read, update, delete: if isAdmin();
    }

    match /stockLogs/{id} {
      allow read, write: if isAdmin();
    }

    match /meta/{id} {
      allow read, write: if isAdmin();
    }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /private/{id} {
      allow read, write: if false;
    }
  }
}
