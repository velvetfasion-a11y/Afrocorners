# Leave Firebase empty to run a clearly marked local preview without Google.
# There is no email/password login.

ADMIN_SESSION_SECRET=

# Allowlist of Google accounts. Set this at deploy time. Do not commit a real address.
# Just nu: ett konto, utvecklaren Julia, med rollen developer.
# Format: email:owner or email:developer, comma-separated.
ADMIN_EMAILS=

# scrypt hash of the admin access code. Generate with npm run hash-access-code.
# Never put the code or this hash in git.
ADMIN_ACCESS_CODE_HASH=

# Firebase client (browser). All six are required together with the service account.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin. Paste the service-account JSON on one line, or point at a file.
# The file must stay off git. This is what lets the server write stock and keep SumUp keys private.
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_SERVICE_ACCOUNT_PATH=

# SumUp is configured by the developer, never in the owner admin.
# One secret API key per physical store. Sales from that merchant code
# decrease that store's stock. Keys must not use a NEXT_PUBLIC_ name.
SUMUP_FITTJA_API_KEY=
SUMUP_FITTJA_MERCHANT_CODE=
SUMUP_MARSTA_API_KEY=
SUMUP_MARSTA_MERCHANT_CODE=

# Optional single-account fallback when only one SumUp account exists.
# SUMUP_STORE_ID is fittja or marsta (default fittja).
SUMUP_API_KEY=
SUMUP_MERCHANT_CODE=
SUMUP_STORE_ID=fittja

# Unlocks /admin/dev for unmatched SumUp lines. Leave empty to hide that page.
DEV_ADMIN_SECRET=

# Vercel Cron sends Authorization: Bearer $CRON_SECRET
CRON_SECRET=

# Optional shared secret for POST /api/sumup/webhook?token=...
# SumUp does not sign webhooks, and does not send them for ordinary in-store sales.
SUMUP_WEBHOOK_TOKEN=
