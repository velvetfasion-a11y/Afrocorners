# Leave these empty to run the shop in local demo mode.
# Demo admin: agare@afrocorner.se / demo1234 (override below).

DEMO_ADMIN_EMAIL=agare@afrocorner.se
DEMO_ADMIN_PASSWORD=demo1234
ADMIN_SESSION_SECRET=

# Firebase client (browser). All six are required together with the service account.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin. Paste the service-account JSON on one line, or point at a file.
# The file must stay off git. This is what lets the server write stock and keep SumUp keys private.
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_SERVICE_ACCOUNT_PATH=

# SumUp. Prefer a secret API key per store account. Never use a NEXT_PUBLIC_ name.
SUMUP_API_KEY=
SUMUP_MERCHANT_CODE=

# Optional OAuth, if you would rather the owner click "Koppla med SumUp".
# Register the redirect URI https://DIN-DOMÄN/api/sumup/oauth/callback
SUMUP_CLIENT_ID=
SUMUP_CLIENT_SECRET=

# Vercel Cron sends Authorization: Bearer $CRON_SECRET
CRON_SECRET=

# Optional shared secret for POST /api/sumup/webhook?token=...
# SumUp does not sign webhooks, and does not send them for ordinary in-store sales.
SUMUP_WEBHOOK_TOKEN=
